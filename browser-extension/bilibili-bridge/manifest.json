{
  "manifest_version": 3,
  "name": "Go Study Bilibili Bridge",
  "version": "0.1.0",
  "description": "Expose the current Bilibili web video position to the local Go Study Obsidian plugin.",
  "host_permissions": [
    "http://127.0.0.1:27124/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
